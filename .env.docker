# ============================================
# Docker-specific environment overrides
# These override the defaults in .env when
# running inside Docker Compose
# ============================================

# Kafka (internal Docker network address)
KAFKA_BROKER=kafka:29092
KAFKA_TOPIC=server-metrics

# PostgreSQL
DATABASE_URL=postgresql://anomaly:anomaly@postgres:5432/anomalydb

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible object store)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=models
MINIO_USE_SSL=false

# Alerting (disable desktop alerts inside containers)
ALERT_METHOD=none

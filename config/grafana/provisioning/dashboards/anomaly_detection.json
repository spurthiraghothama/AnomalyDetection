{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "System Overview",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "id": 1
    },
    {
      "title": "Events Consumed / sec (by node)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "never"
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "rate(events_consumed_total[1m])",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "title": "Processing Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(processing_latency_seconds_bucket[1m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(processing_latency_seconds_bucket[1m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(processing_latency_seconds_bucket[1m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "id": 3
    },
    {
      "title": "Consumer Lag (by partition)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "consumer_lag",
          "legendFormat": "{{node}} partition-{{partition}}",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "title": "Consumer Rebalance Events",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30,
            "drawStyle": "bars",
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "increase(consumer_rebalance_total[1m])",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "title": "Anomaly Detection",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "collapsed": false,
      "id": 6
    },
    {
      "title": "Anomalies Detected / min",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(anomalies_detected_total[1m]))",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "title": "Events Produced Total",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "events_produced_total",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "title": "Duplicates Skipped Total",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "purple",
            "mode": "fixed"
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(events_duplicates_skipped_total) or vector(0)",
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
      "title": "Inference Requests / sec",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "cyan",
            "mode": "fixed"
          },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(inference_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "id": 10
    },
    {
      "title": "Scorer & Leader Election",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "collapsed": false,
      "id": 11
    },
    {
      "title": "Scorer Node Roles (1=Leader, 0=Follower)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0,
          "max": 1.5,
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "node_role",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "id": 12
    },
    {
      "title": "Inference Latency (by scorer node)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(inference_latency_seconds_bucket[1m]))",
          "legendFormat": "{{node}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(inference_latency_seconds_bucket[1m]))",
          "legendFormat": "{{node}} p50",
          "refId": "B"
        }
      ],
      "id": 13
    },
    {
      "title": "Chaos Testing",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false,
      "id": 14
    },
    {
      "title": "Chaos Kills Timeline",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 40,
            "drawStyle": "bars",
            "showPoints": "always",
            "pointSize": 8
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "increase(chaos_kills_total[1m])",
          "legendFormat": "Kills",
          "refId": "A"
        }
      ],
      "id": 15
    },
    {
      "title": "Recovery Time After Kill (seconds)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 15
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "always",
            "pointSize": 10
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "chaos_recovery_seconds_sum / chaos_recovery_seconds_count",
          "legendFormat": "avg recovery",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(1.0, rate(chaos_recovery_seconds_bucket[10m]))",
          "legendFormat": "slowest recovery",
          "refId": "B"
        }
      ],
      "id": 16
    },
    {
      "title": "Node Health",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "collapsed": false,
      "id": 17
    },
    {
      "title": "Service Up / Down Status",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ]
        }
      },
      "options": {
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}} / {{node}}",
          "refId": "A"
        }
      ],
      "id": 18
    }
  ],
  "refresh": "5s",
  "schemaVersion": 30,
  "style": "dark",
  "tags": [
    "anomaly-detection",
    "distributed",
    "chaos"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Anomaly Detection Platform",
  "uid": "anomaly-detection-main",
  "version": 1
